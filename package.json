{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:e2e": "playwright test tests/portfolio.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:analytics": "CONTEXT=deploy-preview PUBLIC_POSTHOG_KEY=phc_test PUBLIC_POSTHOG_HOST=http://127.0.0.1:4321/posthog ANALYTICS_EXPECTED=disabled playwright test tests/analytics.spec.ts && CONTEXT=production PUBLIC_POSTHOG_KEY=phc_test PUBLIC_POSTHOG_HOST=http://127.0.0.1:4321/posthog ANALYTICS_EXPECTED=enabled playwright test tests/analytics.spec.ts",
    "test": "playwright test",
    "lighthouse": "lhci autorun",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test:e2e && pnpm test:a11y && pnpm test:analytics && pnpm build && pnpm lighthouse",
    "netlify": "netlify",
    "netlify:deploy:prod": "netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "astro": "^7.3.5",
    "posthog-js": "^1.435.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "^0.19.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "netlify-cli": "^27.10.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin": "^2.3.11"
  }
}
